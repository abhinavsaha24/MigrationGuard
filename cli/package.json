{
  "name": "@abhinavsaha24/migrationguard",
  "version": "0.1.2",
  "description": "Autonomous continuous compatibility verifier for database migrations across application versions",
  "author": "Abhinav Saha <abhinavsaha24@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhinavsaha24/MigrationGuard.git",
    "directory": "cli"
  },
  "homepage": "https://migrationguard.abhinavsaha.me",
  "bugs": {
    "url": "https://github.com/abhinavsaha24/MigrationGuard/issues"
  },
  "keywords": [
    "database",
    "migrations",
    "zero-downtime",
    "compatibility",
    "prisma",
    "postgresql",
    "verification",
    "ci-cd"
  ],
  "type": "module",
  "bin": {
    "migrationguard": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.map",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --define:__CLI_VERSION__=\\\"0.1.2\\\" --external:commander --external:formdata-node --external:@aws-sdk/* --external:@prisma/client --external:prisma --outfile=dist/index.js",
    "verify": "node ./dist/index.js verify",
    "repair": "node ./dist/index.js repair",
    "benchmark": "node ./dist/index.js benchmark"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.621.0",
    "@prisma/client": "^5.22.0",
    "commander": "^15.0.0",
    "formdata-node": "^6.0.3",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@migrationguard/application-runner": "*",
    "@migrationguard/benchmark-runner": "*",
    "@migrationguard/compatibility": "^0.1.0",
    "@migrationguard/core": "^0.1.0",
    "@migrationguard/evidence": "^0.1.0",
    "@migrationguard/matrix-engine": "^0.1.0",
    "@migrationguard/migration-engine": "*",
    "@migrationguard/repair-planner": "*",
    "@migrationguard/sandbox": "*",
    "@migrationguard/workload": "^0.1.0",
    "esbuild": "^0.21.5"
  }
}
