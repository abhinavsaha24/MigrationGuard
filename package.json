{
  "name": "migrationguard-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "cli"
  ],
  "scripts": {
    "build": "npm run generate --workspace=@migrationguard/poc-app && tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run verify --workspace=@migrationguard/cli",
    "benchmark": "npm run benchmark --workspace=@migrationguard/cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.1"
  }
}
